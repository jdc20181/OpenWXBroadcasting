# Large cleared assets go through Git LFS (install: git lfs install).
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.ogg filter=lfs diff=lfs merge=lfs -text

# Line endings: scripts that run on Linux servers must keep LF.
*.sh text eol=lf
server/** text eol=lf
*.rs text
*.md text
*.toml text
*.svg text
*.png binary
*.ico binary
*.ttf binary
